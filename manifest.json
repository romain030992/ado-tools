{
    "manifest_version": 3,
    "name": "Azure DevOps Tools",
    "version": "1.0",
    "description": "Boîte à outils Azure DevOps",
    "permissions": ["tabs", "scripting", "activeTab", "storage"],
    "host_permissions": ["https://dev.azure.com/*"],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    },
    "background": {
      "service_worker": "background/background.js",
      "type": "module"
    },
  "action": {
      "default_popup": "settings/popup/popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "options_page": "settings/options/options.html",    "web_accessible_resources": [
        {
            "resources": [
                "injection/libs/marked.min.js",
                "injection/libs/purify.min.js",
                "injection/features/core/*.js",
                "injection/features/better-wiki/*.js",
                "injection/features/better-wiki/helpers/*.js",
                "injection/features/quick-filter/*.js",
                "injection/features/quick-filter/helpers/*.js",
                "injection/features/status-aggregation/*.js",
                "injection/features/status-aggregation/helpers/*.js",
                "injection/features/task-drift/*.js",
                "injection/features/task-drift/helpers/*.js",
                "injection/styles/*.css",
                "assets/fontawesome.min.css",
                "assets/fonts/*"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}