{
    "manifest_version": 3,
    "name": "Azure DevOps Sprint Backlog Statistics",
    "version": "1.0",
    "description": "Une extension Chrome pour afficher les statistiques des tâches de sprint dans Azure DevOps",
    "permissions": ["tabs", "scripting", "activeTab", "storage"],
    "host_permissions": ["https://dev.azure.com/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "libs/marked.min.js",
                "libs/purify.min.js"
            ],
            "matches": ["<all_urls>"]
        }
    ]
}