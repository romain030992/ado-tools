{
    "manifest_version": 2,
    "name": "Azure DevOps Tools",
    "version": "1.0",
    "description": "Boîte à outils Azure DevOps",
    "permissions": [
        "tabs",
        "activeTab",
        "storage",
        "https://dev.azure.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "ado-tools@romain030992.github.io",
        "strict_min_version": "57.0"
      }
    },
    "content_security_policy": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;",
    "background": {
      "scripts": ["background/background.js"],
      "persistent": false
    },
    "browser_action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "options_page": "options/options.html",
    "web_accessible_resources": [
        "libs/marked.min.js",
        "libs/purify.min.js",
        "features/core/*.js",
        "features/better-wiki/*.js",
        "features/better-wiki/helpers/*.js",
        "features/quick-filter/*.js",
        "features/quick-filter/helpers/*.js",
        "features/status-aggregation/*.js",
        "features/status-aggregation/helpers/*.js",
        "features/task-drift/*.js",
        "features/task-drift/helpers/*.js",
        "assets/fontawesome.min.css",
        "assets/fonts/*"
    ]
}